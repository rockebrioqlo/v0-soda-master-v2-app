# Copia este archivo a .env.local y completa los valores reales.
# .env.local está en .gitignore: nunca subas credenciales al repositorio.

# Conexión a Neon Postgres (usar la URL con pooler, "-pooler" en el host).
# La app usa el esquema soda_master dentro de esta base.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST-pooler.REGION.aws.neon.tech/NOMBRE_BD?sslmode=require"

# Conexión directa sin pooler (para scripts de migración o inspección).
DATABASE_URL_UNPOOLED="postgresql://USUARIO:PASSWORD@HOST.REGION.aws.neon.tech/NOMBRE_BD?sslmode=require"

# Entorno local
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: logs de depuración de la sincronización de hora (1 = activo)
# DEBUG_NTP=1
